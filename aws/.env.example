# aws/.env.example — Template for aws/.env
#
# Copy this file to aws/.env and fill in your values.
# aws/.env is git-ignored and will NEVER be committed.
#
# Usage:
#   cp aws/.env.example aws/.env
#   # edit aws/.env
#   python aws/preflight.py

# ── AWS region ─────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── EC2 instance ───────────────────────────────────────────────────────────────
# Instance type: g4dn.xlarge (T4 GPU, ~$0.53/hr) is a good default.
EC2_INSTANCE_TYPE=g4dn.xlarge

# Deep Learning AMI Ubuntu 22.04 — us-east-1.
# Run the aws ec2 describe-images command in config.py to find the latest.
EC2_AMI_ID=ami-05ac9f889ac42dd39

# Name of the key pair registered in your AWS account (not the .pem filename).
EC2_KEY_NAME=my-key-pair

# Full path to the local .pem file for that key pair.
EC2_KEY_PATH=/home/youruser/.ssh/my-key-pair.pem

# Root EBS volume size in GB.
EC2_VOLUME_SIZE_GB=45

# SSH user for the AMI: "ubuntu" for Deep Learning AMI, "ec2-user" for AL2.
EC2_SSH_USER=ubuntu
EC2_SSH_PORT=22

# ── Security group ─────────────────────────────────────────────────────────────
# Leave EC2_SG_ID blank to let standup.py create a new security group.
# Set it to an existing sg-xxxxxxxxxxxxxxxxx to reuse one.
EC2_SG_ID=
EC2_SG_NAME=ml-training-sg

# ── IAM instance profile ───────────────────────────────────────────────────────
# Leave blank if the training job doesn't need AWS API access from the instance.
EC2_IAM_PROFILE=

# ── Project tag ────────────────────────────────────────────────────────────────
# Applied to all launched resources for cost tracking in the AWS console.
EC2_PROJECT_TAG=MLTraining
